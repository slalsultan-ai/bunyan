{
  "framework": "nextjs",
  "buildCommand": "npm run db:migrate && npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/weekly-email",
      "schedule": "0 5 * * 0"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "55 20 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 5 * * 0"
    }
  ]
}
